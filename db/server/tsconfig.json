{
  "compilerOptions": {
    "rootDir": ".",
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "types": ["@types/node", "@citizenfx/server", "types"],
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": ["./"]
}
